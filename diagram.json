{
  "version": 1,
  "author": "Smart Solar Load Priority Management System",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-lcd1602", "id": "lcd", "top": -236.8, "left": -44, "attrs": { "pins": "i2c" } },

    { "type": "wokwi-slide-potentiometer", "id": "pot_batt", "top": 280, "left": -250, "attrs": { "travelLength": "30" } },
    { "type": "wokwi-text", "id": "lbl_batt", "top": 250, "left": -250, "attrs": { "text": "BATTERY BUS  0-62.7 V\n(30.0 V = 0%  51.5 V = 100%)" } },
    { "type": "wokwi-slide-potentiometer", "id": "pot_current", "top": 280, "left": 60, "attrs": { "travelLength": "30" } },
    { "type": "wokwi-text", "id": "lbl_curr", "top": 250, "left": 60, "attrs": { "text": "LOAD CURRENT  0-30 A\n(trip 20 A sustained / 26 A hard)" } },

    { "type": "wokwi-relay-module", "id": "relay_crit", "top": -100, "left": -420, "attrs": {} },
    { "type": "wokwi-text", "id": "lbl_rc", "top": -125, "left": -420, "attrs": { "text": "CRITICAL relay (shed <=10%)" } },
    { "type": "wokwi-relay-module", "id": "relay_ess", "top": 10, "left": -420, "attrs": {} },
    { "type": "wokwi-text", "id": "lbl_re", "top": -15, "left": -420, "attrs": { "text": "ESSENTIAL relay (shed <=33%)" } },
    { "type": "wokwi-relay-module", "id": "relay_non", "top": 120, "left": -420, "attrs": {} },
    { "type": "wokwi-text", "id": "lbl_rn", "top": 95, "left": -420, "attrs": { "text": "NON-ESSENTIAL relay (shed <=66%)" } },

    { "type": "wokwi-led", "id": "led_crit", "top": -80, "left": 250, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r_crit", "top": -30, "left": 280, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-text", "id": "lbl_lc", "top": -105, "left": 230, "attrs": { "text": "CRITICAL" } },
    { "type": "wokwi-led", "id": "led_ess", "top": -80, "left": 330, "attrs": { "color": "yellow" } },
    { "type": "wokwi-resistor", "id": "r_ess", "top": -30, "left": 360, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-text", "id": "lbl_le", "top": -105, "left": 310, "attrs": { "text": "ESSENTIAL" } },
    { "type": "wokwi-led", "id": "led_non", "top": -80, "left": 410, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r_non", "top": -30, "left": 440, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-text", "id": "lbl_ln", "top": -105, "left": 395, "attrs": { "text": "NON-ESS" } },

    { "type": "wokwi-buzzer", "id": "bz", "top": 60, "left": 250, "attrs": { "volume": "0.2" } },
    { "type": "wokwi-text", "id": "lbl_bz", "top": 40, "left": 230, "attrs": { "text": "ALARM (GPIO 4)" } },

    { "type": "wokwi-servo", "id": "fan", "top": 60, "left": -700, "attrs": { "hornColor": "#2266cc" } },
    { "type": "wokwi-text", "id": "lbl_fan", "top": 30, "left": -700, "attrs": { "text": "CEILING FAN load\n(powered via ESSENTIAL relay COM/NO)" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:5V", "lcd:VCC", "red", [] ],
    [ "esp:GND.1", "lcd:GND", "black", [] ],
    [ "esp:21", "lcd:SDA", "green", [] ],
    [ "esp:22", "lcd:SCL", "yellow", [] ],

    [ "esp:3V3", "pot_batt:VCC", "red", [] ],
    [ "esp:GND.1", "pot_batt:GND", "black", [] ],
    [ "pot_batt:SIG", "esp:34", "blue", [] ],
    [ "esp:3V3", "pot_current:VCC", "red", [] ],
    [ "esp:GND.1", "pot_current:GND", "black", [] ],
    [ "pot_current:SIG", "esp:32", "orange", [] ],

    [ "esp:5V", "relay_crit:VCC", "red", [] ],
    [ "esp:GND.1", "relay_crit:GND", "black", [] ],
    [ "esp:5", "relay_crit:IN", "green", [] ],
    [ "esp:5V", "relay_ess:VCC", "red", [] ],
    [ "esp:GND.1", "relay_ess:GND", "black", [] ],
    [ "esp:18", "relay_ess:IN", "blue", [] ],
    [ "esp:5V", "relay_non:VCC", "red", [] ],
    [ "esp:GND.1", "relay_non:GND", "black", [] ],
    [ "esp:19", "relay_non:IN", "purple", [] ],

    [ "esp:5", "led_crit:A", "green", [] ],
    [ "led_crit:C", "r_crit:1", "black", [] ],
    [ "r_crit:2", "esp:GND.2", "black", [] ],
    [ "esp:18", "led_ess:A", "blue", [] ],
    [ "led_ess:C", "r_ess:1", "black", [] ],
    [ "r_ess:2", "esp:GND.2", "black", [] ],
    [ "esp:19", "led_non:A", "purple", [] ],
    [ "led_non:C", "r_non:1", "black", [] ],
    [ "r_non:2", "esp:GND.2", "black", [] ],

    [ "esp:4", "bz:2", "orange", [] ],
    [ "bz:1", "esp:GND.2", "black", [] ],

    [ "esp:5V", "relay_ess:COM", "red", [] ],
    [ "relay_ess:NO", "fan:V+", "red", [] ],
    [ "fan:GND", "esp:GND.1", "black", [] ],
    [ "esp:23", "fan:PWM", "orange", [] ]
  ],
  "dependencies": {}
}
